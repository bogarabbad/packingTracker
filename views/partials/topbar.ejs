<header class="ui-topbar">
  <div class="flex items-center gap-3">
    <button
      type="button"
      id="btn-sidebar-toggle"
      class="ui-btn ui-btn-ghost ui-btn-icon"
      aria-label="Abrir menú"
      aria-controls="app-sidebar"
      aria-expanded="false"
    >
      <svg class="ui-icon-burger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>
    <h1 class="text-base font-semibold tracking-tight sm:text-lg">
      <%= locals.title || '' %>
    </h1>
  </div>
  <div class="flex items-center gap-3">
    <span id="session-user" class="hidden text-sm text-muted-foreground sm:inline"></span>
    <%- include('button', { label: 'Salir', variant: 'outline', size: 'sm', id: 'btn-logout', attrs: 'type="button"' }) %>
  </div>
</header>
