{
  "name": "packing-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "API para la trazabilidad de la carga de camiones. El documento de carga es el packing list, identificado por folio.",
  "main": "src/server.js",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./src/frontend/input.css -o ./public/css/styles.css",
    "watch:css": "tailwindcss -i ./src/frontend/input.css -o ./public/css/styles.css --watch"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "ejs": "^7.0.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
