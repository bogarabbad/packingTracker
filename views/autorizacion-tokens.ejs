<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tokens de autorización · packingTracker</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="ui-app">
      <%- include('partials/sidebar', { active: 'autorizacion-tokens' }) %>
      <div class="ui-app-main">
        <%- include('partials/topbar', { title: 'Tokens de autorización' }) %>
        <main class="ui-page">
          <section class="flex flex-wrap items-center justify-between gap-3">
            <p id="at-status" class="text-sm text-muted-foreground">Cargando…</p>
            <%- include('partials/button', {
              label: 'Nuevo token',
              variant: 'default',
              size: 'md',
              id: 'at-btn-new'
            }) %>
          </section>

          <form id="at-filters" class="ui-filters">
            <div class="flex flex-col gap-2">
              <label class="ui-label" for="at-filter-q">Buscar</label>
              <input class="ui-input" id="at-filter-q" name="q" placeholder="Nombre o token" autocomplete="off" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="ui-label" for="at-filter-dispositivo">Dispositivo</label>
              <select class="ui-input" id="at-filter-dispositivo" name="id_dispositivo">
                <option value="">Todos</option>
              </select>
            </div>
            <div class="flex flex-col gap-2">
              <label class="ui-label" for="at-filter-activo">Activo</label>
              <select class="ui-input" id="at-filter-activo" name="activo">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
              </select>
            </div>
            <div class="ui-filters-actions">
              <button type="submit" class="ui-btn ui-btn-default ui-btn-md">Filtrar</button>
              <button type="button" id="at-filters-clear" class="ui-btn ui-btn-outline ui-btn-md">Limpiar</button>
            </div>
          </form>

          <%- include('partials/card', {
            body: `
              <div class="ui-table-wrap">
                <table class="ui-table" aria-label="Tokens de autorización">
                  <thead>
                    <tr>
                      <th scope="col">Nombre</th>
                      <th scope="col">Token</th>
                      <th scope="col">Dispositivo</th>
                      <th scope="col">Expira</th>
                      <th scope="col">Último uso</th>
                      <th scope="col">Activo</th>
                      <th scope="col" class="text-right">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="at-tbody">
                    <tr>
                      <td colspan="7" class="text-muted-foreground">Sin registros.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <p id="at-page-label" class="text-sm text-muted-foreground"></p>
                <div class="flex gap-2">
                  <button type="button" id="at-prev" class="ui-btn ui-btn-outline ui-btn-sm" disabled>Anterior</button>
                  <button type="button" id="at-next" class="ui-btn ui-btn-outline ui-btn-sm" disabled>Siguiente</button>
                </div>
              </div>
            `
          }) %>
        </main>
      </div>
    </div>

    <dialog id="at-form-dialog" class="ui-dialog-panel" aria-labelledby="at-form-title">
      <header class="flex flex-col gap-2 text-left">
        <h2 id="at-form-title" class="ui-dialog-title">Nuevo token</h2>
      </header>
      <form id="at-form" class="mt-4 grid gap-4">
        <input type="hidden" id="at-id" value="" />
        <div class="flex flex-col gap-2">
          <label class="ui-label" for="at-nombre">Nombre</label>
          <input class="ui-input" id="at-nombre" name="NOMBRE" required autocomplete="off" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="ui-label" for="at-token">Token</label>
          <div class="flex gap-2">
            <input class="ui-input min-w-0 flex-1" id="at-token" name="TOKEN" required autocomplete="off" />
            <button type="button" id="at-token-generate" class="ui-btn ui-btn-outline ui-btn-md shrink-0">Generar</button>
          </div>
          <p class="text-xs text-muted-foreground">Valor que configura la app Android (p. ej. por QR).</p>
        </div>
        <div class="flex flex-col gap-2">
          <label class="ui-label" for="at-id-dispositivo">Dispositivo</label>
          <select class="ui-input" id="at-id-dispositivo" name="ID_DISPOSITIVO">
            <option value="">Sin dispositivo</option>
          </select>
        </div>
        <div class="flex flex-col gap-2">
          <label class="ui-label" for="at-expira-en">Expira</label>
          <input class="ui-input" id="at-expira-en" name="EXPIRA_EN" type="datetime-local" />
          <p class="text-xs text-muted-foreground">Vacío = sin vencimiento.</p>
        </div>
        <div class="flex items-center gap-2">
          <input id="at-activo" name="ACTIVO" type="checkbox" checked class="size-4 rounded border-input" />
          <label class="ui-label" for="at-activo">Activo</label>
        </div>
        <p id="at-form-error" class="hidden text-sm text-destructive" role="alert"></p>
        <footer class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <button type="button" id="at-form-cancel" class="ui-btn ui-btn-outline ui-btn-md">Cancelar</button>
          <button type="submit" id="at-form-submit" class="ui-btn ui-btn-default ui-btn-md">Guardar</button>
        </footer>
      </form>
    </dialog>

    <dialog id="at-delete-dialog" class="ui-dialog-panel" aria-labelledby="at-delete-title">
      <header class="flex flex-col gap-2 text-left">
        <h2 id="at-delete-title" class="ui-dialog-title">Eliminar token</h2>
        <p class="ui-dialog-description" id="at-delete-text">¿Eliminar este token?</p>
      </header>
      <footer class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" id="at-delete-cancel" class="ui-btn ui-btn-outline ui-btn-md">Cancelar</button>
        <button type="button" id="at-delete-confirm" class="ui-btn ui-btn-destructive ui-btn-md">Eliminar</button>
      </footer>
    </dialog>

    <dialog id="at-qr-dialog" class="ui-dialog-panel" aria-labelledby="at-qr-title">
      <header class="flex flex-col gap-2 text-left">
        <h2 id="at-qr-title" class="ui-dialog-title">QR de enrollment</h2>
        <p class="ui-dialog-description" id="at-qr-name"></p>
      </header>
      <div class="mt-4 flex flex-col items-center gap-3">
        <img id="at-qr-image" alt="Código QR del token" class="size-64 rounded border border-border bg-white p-2" />
        <p id="at-qr-payload" class="max-w-full break-all font-mono text-xs text-muted-foreground"></p>
        <p class="text-center text-xs text-muted-foreground">
          Prefijo <code>PTENR|</code> (acción enrollment). La app llama a
          <code>POST /enrollment</code> con el token sin prefijo.
        </p>
      </div>
      <footer class="mt-4 flex justify-end">
        <button type="button" id="at-qr-close" class="ui-btn ui-btn-outline ui-btn-md">Cerrar</button>
      </footer>
    </dialog>

    <%- include('partials/toast-viewport') %>
    <script src="/js/api.js" defer></script>
    <script src="/js/toast.js" defer></script>
    <script src="/js/app-shell.js" defer></script>
    <script src="/js/autorizacion-tokens.js" defer></script>
  </body>
</html>
