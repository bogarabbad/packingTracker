<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso · packingTracker</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <main class="mx-auto flex min-h-screen max-w-md flex-col justify-center gap-6 px-4 py-10">
      <div class="flex flex-col gap-2 text-center">
        <h1 class="text-2xl font-semibold tracking-tight">packingTracker</h1>
        <p class="text-sm text-muted-foreground">Acceso con usuario interno</p>
      </div>

      <section class="ui-card">
        <header class="ui-card-header">
          <h2 class="ui-card-title">Iniciar sesión</h2>
        </header>
        <div class="ui-card-content">
          <form id="login-form" class="flex flex-col gap-4" novalidate>
            <div class="flex flex-col gap-2">
              <%- include('partials/label', { text: 'Código', forId: 'codigo' }) %>
              <%- include('partials/input', { id: 'codigo', name: 'CODIGO', required: true, attrs: 'autocomplete="username"' }) %>
            </div>
            <div class="flex flex-col gap-2">
              <%- include('partials/label', { text: 'Contraseña', forId: 'contrasena' }) %>
              <%- include('partials/input', { id: 'contrasena', name: 'CONTRASENA', type: 'password', required: true, attrs: 'autocomplete="current-password"' }) %>
            </div>
            <p id="login-error" class="hidden text-sm text-destructive" role="alert"></p>
            <%- include('partials/button', { label: 'Entrar', type: 'submit', variant: 'default', size: 'md', className: 'w-full', id: 'login-submit' }) %>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/toast-viewport') %>
    <script src="/js/api.js" defer></script>
    <script src="/js/toast.js" defer></script>
    <script src="/js/login.js" defer></script>
  </body>
</html>
