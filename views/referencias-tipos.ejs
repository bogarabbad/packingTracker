<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tipos de referencia · packingTracker</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <div class="ui-app">
      <%- include('partials/sidebar', { active: 'referencias-tipos' }) %>
      <div class="ui-app-main">
        <%- include('partials/topbar', { title: 'Tipos de referencia' }) %>
        <main class="ui-page">
          <section class="flex flex-wrap items-center justify-between gap-3">
            <p id="rt-status" class="text-sm text-muted-foreground">Cargando…</p>
            <%- include('partials/button', {
              label: 'Nuevo tipo',
              variant: 'default',
              size: 'md',
              id: 'rt-btn-new'
            }) %>
          </section>

          <form id="rt-filters" class="ui-filters">
            <div class="flex flex-col gap-2">
              <label class="ui-label" for="rt-filter-q">Buscar</label>
              <input class="ui-input" id="rt-filter-q" name="q" placeholder="Código, clave o nombre" autocomplete="off" />
            </div>
            <div class="flex flex-col gap-2">
              <label class="ui-label" for="rt-filter-activo">Activo</label>
              <select class="ui-input" id="rt-filter-activo" name="activo">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
              </select>
            </div>
            <div class="ui-filters-actions">
              <button type="submit" class="ui-btn ui-btn-default ui-btn-md">Filtrar</button>
              <button type="button" id="rt-filters-clear" class="ui-btn ui-btn-outline ui-btn-md">Limpiar</button>
            </div>
          </form>

          <%- include('partials/card', {
            body: `
              <div class="ui-table-wrap">
                <table class="ui-table" aria-label="Tipos de referencia">
                  <thead>
                    <tr>
                      <th scope="col">Código</th>
                      <th scope="col">Clave</th>
                      <th scope="col">Nombre</th>
                      <th scope="col">Activo</th>
                      <th scope="col" class="text-right">Acciones</th>
                    </tr>
                  </thead>
                  <tbody id="rt-tbody">
                    <tr>
                      <td colspan="5" class="text-muted-foreground">Sin registros.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <p id="rt-page-label" class="text-sm text-muted-foreground"></p>
                <div class="flex gap-2">
                  <button type="button" id="rt-prev" class="ui-btn ui-btn-outline ui-btn-sm" disabled>Anterior</button>
                  <button type="button" id="rt-next" class="ui-btn ui-btn-outline ui-btn-sm" disabled>Siguiente</button>
                </div>
              </div>
            `
          }) %>
        </main>
      </div>
    </div>

    <dialog id="rt-form-dialog" class="ui-dialog-panel" aria-labelledby="rt-form-title">
      <header class="flex flex-col gap-2 text-left">
        <h2 id="rt-form-title" class="ui-dialog-title">Nuevo tipo</h2>
      </header>
      <form id="rt-form" class="mt-4 grid gap-4">
        <input type="hidden" id="rt-id" value="" />
        <div class="flex flex-col gap-2">
          <label class="ui-label" for="rt-codigo">Código</label>
          <input class="ui-input" id="rt-codigo" name="CODIGO" required autocomplete="off" />
        </div>
        <div class="flex flex-col gap-2">
          <label class="ui-label" for="rt-clave">Clave</label>
          <input class="ui-input" id="rt-clave" name="CLAVE" required maxlength="8" autocomplete="off" />
          <p class="text-xs text-muted-foreground">Abreviatura única (máx. 8). Packing usa P.</p>
        </div>
        <div class="flex flex-col gap-2">
          <label class="ui-label" for="rt-nombre">Nombre</label>
          <input class="ui-input" id="rt-nombre" name="NOMBRE" required autocomplete="off" />
        </div>
        <div class="flex items-center gap-2">
          <input id="rt-activo" name="ACTIVO" type="checkbox" checked class="size-4 rounded border-input" />
          <label class="ui-label" for="rt-activo">Activo</label>
        </div>
        <p id="rt-form-error" class="hidden text-sm text-destructive" role="alert"></p>
        <footer class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <button type="button" id="rt-form-cancel" class="ui-btn ui-btn-outline ui-btn-md">Cancelar</button>
          <button type="submit" id="rt-form-submit" class="ui-btn ui-btn-default ui-btn-md">Guardar</button>
        </footer>
      </form>
    </dialog>

    <dialog id="rt-delete-dialog" class="ui-dialog-panel" aria-labelledby="rt-delete-title">
      <header class="flex flex-col gap-2 text-left">
        <h2 id="rt-delete-title" class="ui-dialog-title">Eliminar tipo</h2>
        <p class="ui-dialog-description" id="rt-delete-text">¿Eliminar este tipo de referencia?</p>
      </header>
      <footer class="mt-4 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <button type="button" id="rt-delete-cancel" class="ui-btn ui-btn-outline ui-btn-md">Cancelar</button>
        <button type="button" id="rt-delete-confirm" class="ui-btn ui-btn-destructive ui-btn-md">Eliminar</button>
      </footer>
    </dialog>

    <%- include('partials/toast-viewport') %>
    <script src="/js/api.js" defer></script>
    <script src="/js/toast.js" defer></script>
    <script src="/js/app-shell.js" defer></script>
    <script src="/js/referencias-tipos.js" defer></script>
  </body>
</html>
