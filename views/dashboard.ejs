<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard · packingTracker</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <%- include('partials/header') %>

    <main class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-8 sm:px-6">
      <section class="flex flex-col gap-2">
        <h1 class="text-2xl font-semibold tracking-tight">Panel de operaciones</h1>
      </section>

      <section class="grid gap-4 sm:grid-cols-3" id="stats-grid" aria-live="polite">
        <%- include('partials/card', {
          title: 'Tipos de lote',
          description: 'Catálogo activo',
          contentId: 'stat-lotes-tipos',
          body: '<p class="text-3xl font-semibold tabular-nums">—</p><p class="mt-1 text-xs text-muted-foreground">Cargando…</p>'
        }) %>
        <%- include('partials/card', {
          title: 'Unidades de medida',
          description: 'Catálogo activo',
          contentId: 'stat-unidades',
          body: '<p class="text-3xl font-semibold tabular-nums">—</p><p class="mt-1 text-xs text-muted-foreground">Cargando…</p>'
        }) %>
        <%- include('partials/card', {
          title: 'Lotes',
          description: 'Registros actuales',
          contentId: 'stat-lotes',
          body: '<p class="text-3xl font-semibold tabular-nums">—</p><p class="mt-1 text-xs text-muted-foreground">Cargando…</p>'
        }) %>
      </section>

      <%- include('partials/card', {
        title: 'Tipos de referencia',
        body: `
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <span id="refs-status" class="text-sm text-muted-foreground">Preparando…</span>
          </div>
          <div class="ui-table-wrap">
            <table class="ui-table" aria-label="Tipos de referencia">
              <thead>
                <tr>
                  <th scope="col">ID</th>
                  <th scope="col">Código</th>
                  <th scope="col">Nombre</th>
                  <th scope="col">Estado</th>
                </tr>
              </thead>
              <tbody id="refs-tbody">
                <tr>
                  <td colspan="4" class="text-muted-foreground">Sin datos todavía.</td>
                </tr>
              </tbody>
            </table>
          </div>
        `
      }) %>

    </main>

    <%- include('partials/toast-viewport') %>
    <script src="/js/api.js" defer></script>
    <script src="/js/toast.js" defer></script>
    <script src="/js/dashboard.js" defer></script>
  </body>
</html>
