<%#
  active: 'dashboard' | 'lotes' | 'expediciones' | 'unidades-transporte' | 'unidades-tipos' | 'unidades-estatus' | 'unidades-medida' | 'lotes-tipos' | 'referencias-tipos'
%>
<%
  const active = locals.active || '';
  function navClass(key) {
    const base = 'ui-sidebar-link';
    return key === active ? `${base} ui-sidebar-link-active` : base;
  }
%>
<aside id="app-sidebar" class="ui-sidebar" aria-label="Navegación principal">
  <div class="ui-sidebar-brand">
    <a href="/dashboard" class="text-lg font-semibold tracking-tight text-foreground">
      packingTracker
    </a>
  </div>

  <nav class="ui-sidebar-nav">
    <p class="ui-sidebar-section">Operación</p>
    <a href="/dashboard" class="<%= navClass('dashboard') %>">Panel</a>
    <a href="/operacion/lotes" class="<%= navClass('lotes') %>">Lotes</a>
    <a href="/operacion/expediciones" class="<%= navClass('expediciones') %>">Expediciones</a>

    <p class="ui-sidebar-section">Unidades de transporte</p>
    <a href="/catalogos/unidades-transporte" class="<%= navClass('unidades-transporte') %>">
      Unidades
    </a>
    <a href="/catalogos/unidades-tipos" class="<%= navClass('unidades-tipos') %>">
      Tipos
    </a>
    <a href="/catalogos/unidades-estatus" class="<%= navClass('unidades-estatus') %>">
      Estatus
    </a>

    <p class="ui-sidebar-section">Catálogos</p>
    <a href="/catalogos/lotes-tipos" class="<%= navClass('lotes-tipos') %>">
      Tipos de lotes
    </a>
    <a href="/catalogos/unidades-medida" class="<%= navClass('unidades-medida') %>">
      Unidades de medida
    </a>
    <a href="/catalogos/referencias-tipos" class="<%= navClass('referencias-tipos') %>">
      Tipos de referencia
    </a>
  </nav>
</aside>
<div id="sidebar-backdrop" class="ui-sidebar-backdrop" hidden></div>
