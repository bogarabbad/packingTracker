PORT=3000

# Dentro del contenedor, localhost es el propio contenedor.
# Si PostgreSQL corre en el host, define PGHOST=host.docker.internal en .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=packing_tracker
PGUSER=packing
PGPASSWORD=

# Firma de los JWT. Obligatoria. No uses este valor en producción.
JWT_SECRET=change-me-in-production
# Vigencia del access token en segundos. Por defecto 8 horas.
JWT_EXPIRES_IN=28800
JWT_ISSUER=packing-tracker
JWT_AUDIENCE=packing-tracker-api

# Usuario semilla ADMIN. Contraseña temporal del init/migración 0018.
# ADMIN / Admin123!
# Cámbiala después del primer acceso.
